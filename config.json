{
  "total_budget": 8000,
  "currency": "Kč",
  "allow_missing_price": false,
  "max_seen_ids": 5000,
  "catalog_retention_days": 14,

  "request": {
    "timeout_seconds": 20,
    "min_delay_seconds": 1.0,
    "max_delay_seconds": 3.0,
    "max_pages_per_query": 1,
    "max_retries": 2
  },

  "browser": {
    "headless": true,
    "page_timeout_seconds": 45,
    "challenge_timeout_seconds": 40,
    "min_delay_seconds": 1.5,
    "max_delay_seconds": 3.5
  },

  "sites": {
    "bazos": {
      "enabled": true,
      "query_mode": "all",
      "max_pages_per_query": 1
    },
    "cyklobazar": {
      "enabled": true,
      "query_mode": "broad",
      "max_pages_per_query": 2
    }
  },

  "broad_queries": ["shimano 105", "shimano grx"],

  "matching": {
    "bundle_min_matches": 3,
    "bundle_markers": ["sada", "grupa", "groupset", "group set", "komplet", "sestava"],
    "relevance_any": ["105", "grx"],
    "fallback_to_query_category": true,
    "global_exclude": [
      "detsk", "dětsk", "odrazedl", "odrážedl", "kolobezk", "koloběžk",
      "elektrokolo", "e-bike", "ebike", "elektro kolo",
      "trenazer", "trenažér", "rotoped",
      "zapletena kola", "zapletená kola", "cele kolo", "celé kolo",
      "kompletni kolo", "kompletní kolo",
      "helma", "prilba", "přilba", "tretry", "rukavice",
      "hledam", "hledám", "koupim", "koupím", "poptavam", "poptávám"
    ]
  },

  "categories": [
    {
