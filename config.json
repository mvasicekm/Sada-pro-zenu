      "queries": ["shimano 105 sada", "shimano grx sada", "grupa"],
      "match_any": ["sada", "grupa", "groupset", "sestava", "komplet"],
      "models": [],
      "exclude": []
    },
    {
      "key": "paky_brzdy",
      "label": "Páky / Brzdy",
      "max_price": 4500,
      "queries": [
