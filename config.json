        "st-r7020", "st-r7000", "st-rx600", "st-rx810", "br-r7070", "br-rx400"
      ],
      "match_any": ["paky", "paka", "dual", "brzd", "shifter", "radici paky", "kotoucove brzdy"],
      "models": ["st-r7020", "st-r7000", "st-rx600", "st-rx810", "br-r7070", "br-rx400", "br-r7000"],
      "exclude": ["bowden", "gumicky", "gumičky", "krytky", "objimka", "objímka", "destick", "destičk", "kotouc", "kotouč", "adapter", "adaptér"]
    },
    {
